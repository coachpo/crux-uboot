# Bring-up environment for Xiaomi Mi 9 Pro 5G (crux)
#
# The phone has no external UART, so the first job is to bring the USB
# (CDC-ACM) console up automatically, then show the boot menu.

# bootdelay=-1 would disable autoboot completely and drop to the shell;
# bootcmd=bootmenu shows the menu while waiting for an explicit selection.
bootdelay=0
loglevel=7
bootretry=-1
stdin=serial,button-kbd
stdout=serial,vidconsole
stderr=serial,vidconsole

# Probe storage and enable the USB serial gadget console on every boot.
preboot=log level 6; scsi scan; run serial_gadget
fastboot_addr_r=0xC0000000

# NOTE: keep every value on ONE line.  The default-env generator
# (filechk_defaultenv.h) joins backslash continuations with GNU-only
# sed escapes (\x0\s*); BSD sed on macOS does not understand them and
# leaves every continuation line as a bogus separate variable.
serial_gadget=setenv stdin serial,button-kbd,usbacm; setenv stdout serial,vidconsole,usbacm; setenv stderr serial,vidconsole,usbacm; echo "USB CDC-ACM console enabled"

# Keep the menu waiting after a watchdog reset instead of booting the same
# stalled kernel again. bootdelay must stay zero so bootcmd shows the menu.
# U-Boot's bootmenu treats a negative or zero delay as "time out immediately
# and run the default entry" (the first one), so
# the countdown is given a value that only expires after a day; any key still
# selects an entry (key 8 drops to the shell).
menucmd=bootmenu 86400
bootcmd=run menucmd

# The SM8150 APSS watchdog remains armed across the Linux handoff. U-Boot
# services it while commands run; a working kernel takes over its hardware.
# Check both commands so a failed watchdog setup leaves us at the shell.
kernel_watchdog_ms=30000
boot_go=if wdt dev watchdog@17c10000; then if wdt start ${kernel_watchdog_ms}; then bootm go; fi; fi

# Cache partition payloads (LUN0 starts at LBA 0x30000, 4096-byte blocks):
#   0x00000000: miui-menu.itb      (mainline stock kernel + official DT, 0x28bd blocks)
#   0x04000000: twrp-menu.itb      (TWRP 3.7.1 haptics Release + live ABL DT, 0x2924 blocks)
#   0x08000000: pe-recovery.itb    (PixelExperience recovery: PE kernel + gzip ramdisk + live DT, 0x3b00 blocks)
#   0x0c000000: pe-rom.itb         (PixelExperience system: PE kernel + boot ramdisk + live DT, 0x3100 blocks)
boot_miui=scsi dev 0; scsi read 0xC0000000 0x30000 0x28bd; bootm start 0xC0000000; bootm loados; bootm prep; run boot_go

# boot_twrp runs the Cepheus-baseline TWRP image.  Like the PE entries it
# leaves fdt_high/initrd_high unset: the Cepheus kernel image_size is
# 0x3298000 (ends at 0x83318000) and the TWRP ramdisk is 24.5 MiB, so the old
# low initrd_high=0x84200000 leaves only ~15 MiB and the ramdisk allocation
# fails; U-Boot must relocate the ramdisk/FDT above the kernel image.
boot_twrp=scsi dev 0; scsi read 0xC0000000 0x34000 0x2924; setenv fdt_high; setenv initrd_high; bootm start 0xC0000000; bootm loados; bootm ramdisk; bootm prep; run boot_go

# The Cepheus-derived PE kernel footprint (arm64 image_size 0x3298000) is larger
# than the stock kernel (0x2e4e000). U-Boot's FIT path reserves the entire image,
# so a low initrd_high/fdt_high would place the ramdisk inside the PE kernel BSS
# and it would be wiped while the kernel clears BSS.  Leave both unset for the PE
# entries so U-Boot relocates the ramdisk/FDT above the kernel image.
boot_pe_recovery=scsi dev 0; scsi read 0xC0000000 0x38000 0x3b00; setenv fdt_high; setenv initrd_high; bootm start 0xC0000000; bootm loados; bootm ramdisk; bootm prep; run boot_go

# PE uses its source-built native first-stage ramdisk. Its crux_uboot fstab
# mounts the PE-only system/vendor/data/metadata volumes and retains FBE.
# Relocate the initrd before entry, away from the kernel's BSS.
boot_pe_rom=scsi dev 0; scsi read 0xC0000000 0x3c000 0x3100; setenv fdt_high; setenv initrd_high; bootm start 0xC0000000; bootm loados; bootm ramdisk; bootm prep; run boot_go

boot_pe_rom_rd=scsi dev 0; scsi read 0xC0000000 0x3c000 0x3100; setenv fdt_high; setenv initrd_high; bootm start 0xC0000000; bootm loados; bootm ramdisk; bootm prep; run boot_go

# Menu order also defines the timeout default (U-Boot selects the first
# entry) and the digit keys (bootmenu_0 = key 1, bootmenu_1 = key 2, ...).
# MIUI is first; keep TWRP at key 3 and the shell at key 8 for console tools.
bootmenu_0=Boot official MIUI=run boot_miui
bootmenu_1=Boot PixelExperience recovery=run boot_pe_recovery
bootmenu_2=Boot TWRP 3.7.1 recovery=run boot_twrp
bootmenu_3=Boot PixelExperience=run boot_pe_rom
bootmenu_4=Enable USB CDC-ACM console=run serial_gadget
bootmenu_5=Enable USB mass storage=run usb_mass_storage
bootmenu_6=Enable fastboot mode=run usb_fastboot
bootmenu_7=Drop to shell=setenv bootretry -1
bootmenu_8=Board info=bdinfo
bootmenu_9=Dump environment=printenv
bootmenu_10=UFS device info=scsi info
bootmenu_11=Reset device=reset

button_cmd_0_name=Volume Down
button_cmd_0=run menucmd

# Handy shortcuts.
fastboot=fastboot -l $fastboot_addr_r usb 0

# Drop the USB CDC-ACM console: only one g_dnl composite can be registered at
# a time, and its stop() releases the UDC for the next gadget function.
stop_acm=setenv stdin serial,button-kbd; setenv stdout serial,vidconsole; setenv stderr serial,vidconsole

# U-Boot's fastboot gadget.  Exit with any phone key, or with
# "fastboot reboot" from the host; the ACM console is then brought back.
usb_fastboot=run stop_acm; echo "ACM stopped, starting fastboot"; fastboot usb 0; echo "fastboot exited, restoring console"; run serial_gadget

# USB mass storage (whole LUN0).  Any phone key aborts it; the ACM console is
# then brought back.
usb_mass_storage=run stop_acm; echo "ACM stopped, starting UMS"; ums 0 scsi 0; echo "UMS exited, restoring console"; run serial_gadget
