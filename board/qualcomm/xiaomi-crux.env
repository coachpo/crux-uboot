# Bring-up environment for Xiaomi Mi 9 Pro 5G (crux)
#
# The phone has no external UART, so the first job is to bring the USB
# (CDC-ACM) console up automatically, then show the boot menu.

# bootdelay=-1 would disable autoboot completely and drop to the shell;
# bootcmd=bootmenu provides the actual 10-second countdown.
bootdelay=0
loglevel=7
bootretry=-1
stdin=serial,button-kbd
stdout=serial,vidconsole
stderr=serial,vidconsole

# Probe storage and enable the USB serial gadget console on every boot.
preboot=log level 6; scsi scan; run serial_gadget
fastboot_addr_r=0xC0000000

# NOTE: keep every value on ONE line.  The default-env generator
# (filechk_defaultenv.h) joins backslash continuations with GNU-only
# sed escapes (\x0\s*); BSD sed on macOS does not understand them and
# leaves every continuation line as a bogus separate variable.
serial_gadget=setenv stdin serial,button-kbd,usbacm; setenv stdout serial,vidconsole,usbacm; setenv stderr serial,vidconsole,usbacm; echo "USB CDC-ACM console enabled"

# Boot menu: shown on every boot, auto-boots MIUI after 10 seconds.
menucmd=bootmenu 10
bootcmd=run menucmd

# Cache partition payloads (LUN0 starts at LBA 0x30000, 4096-byte blocks):
#   0x00000000: miui-menu.itb (mainline stock kernel + official DT, 0x28bd blocks)
#   0x04000000: twrp-menu.itb (TWRP recovery image + live ABL DT, 0x3486 blocks)
boot_miui=scsi dev 0; scsi read 0xC0000000 0x30000 0x28bd; bootm start 0xC0000000; bootm loados; bootm prep; bootm go

boot_twrp=scsi dev 0; scsi read 0xC0000000 0x34000 0x3486; setenv fdt_high 0x84900000; setenv initrd_high 0x84200000; bootm start 0xC0000000; bootm loados; bootm ramdisk; bootm prep; bootm go

bootmenu_0=Boot official MIUI=run boot_miui
bootmenu_1=Boot TWRP recovery=run boot_twrp
bootmenu_2=Enable USB CDC-ACM console=run serial_gadget
bootmenu_3=Enable USB mass storage=echo "Press any key to exit UMS"; ums 0 scsi 0
bootmenu_4=Enable fastboot mode=run fastboot
bootmenu_5=Drop to shell=setenv bootretry -1
bootmenu_6=Board info=bdinfo
bootmenu_7=Dump environment=printenv
bootmenu_8=UFS device info=scsi info
bootmenu_9=Reset device=reset

button_cmd_0_name=Volume Down
button_cmd_0=run menucmd

# Handy shortcuts.
fastboot=fastboot -l $fastboot_addr_r usb 0
usb_mass_storage=ums 0 scsi 0

# Drop the USB CDC-ACM console (its stop() releases the UDC) and
# start U-Boot's fastboot gadget instead.
usb_fastboot=setenv stdin serial,button-kbd; setenv stdout serial,vidconsole; setenv stderr serial,vidconsole; echo "ACM stopped, starting fastboot"; fastboot usb 0
